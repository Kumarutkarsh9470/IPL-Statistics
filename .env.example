# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ipl_user
DB_PASSWORD=your_secure_password_here
DB_NAME=ipl_db

# FastAPI Server (if using ml/serve.py)
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# External LLM API (for natural language queries)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4

# Kaggle Dataset (for data refresh)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
