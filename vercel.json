{
  "buildCommand": "bash build.sh",
  "framework": "python",
  "outputDirectory": ".",
  "functions": {
    "api/*.py": {
      "runtime": "python3.12"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/portal/index.html"
    }
  ]
}
