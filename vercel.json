{
  "buildCommand": "pip install -r requirements.txt",
  "framework": "python",
  "outputDirectory": ".",
  "functions": {
    "api/*.py": {
      "runtime": "python3.12"
    }
  },
  "env": {
    "DB_HOST": "@db_host",
    "DB_PORT": "@db_port",
    "DB_USER": "@db_user",
    "DB_PASSWORD": "@db_password",
    "DB_NAME": "@db_name"
  }
}
